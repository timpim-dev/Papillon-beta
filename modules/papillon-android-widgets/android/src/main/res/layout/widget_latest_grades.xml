<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_background"
  android:orientation="vertical"
  android:padding="12dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp"
    android:paddingBottom="8dp">

    <TextView
      android:id="@+id/widget_header_title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:fontFamily="sans-serif-medium"
      android:maxLines="1"
      android:text="@string/widget_latest_grades_title"
      android:textColor="@color/papillon_widget_text_secondary"
      android:textSize="13.5sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/widget_average_badge"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/widget_neutral_pill"
      android:fontFamily="sans-serif-medium"
      android:paddingHorizontal="10dp"
      android:paddingVertical="4dp"
      android:text="@string/widget_see_more"
      android:textColor="@color/papillon_widget_text_secondary"
      android:textSize="11sp"
      android:textStyle="bold" />
  </LinearLayout>

  <TextView
    android:id="@+id/widget_empty_text"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center"
    android:text="@string/widget_latest_grades_empty"
    android:textColor="@color/papillon_widget_text_secondary"
    android:textSize="13sp"
    android:visibility="gone" />

  <FrameLayout
    android:id="@+id/grade_1_container"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:visibility="gone">

    <ImageView
      android:id="@+id/grade_1_bg"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:contentDescription="@null"
      android:scaleType="fitXY"
      android:src="@drawable/widget_item_tintable" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingHorizontal="13dp"
      android:paddingVertical="7dp">

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:id="@+id/grade_1_subject"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:fontFamily="sans-serif-medium"
          android:maxLines="1"
          android:textSize="11.5sp" />

        <TextView
          android:id="@+id/grade_1_subtitle"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:ellipsize="end"
          android:fontFamily="sans-serif-medium"
          android:maxLines="1"
          android:textSize="13.5sp"
          android:textStyle="bold" />
      </LinearLayout>

      <TextView
        android:id="@+id/grade_1_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textSize="15.5sp"
        android:textStyle="bold" />
    </LinearLayout>
  </FrameLayout>

  <FrameLayout
    android:id="@+id/grade_2_container"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="6dp"
    android:layout_weight="1"
    android:visibility="gone">

    <ImageView
      android:id="@+id/grade_2_bg"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:contentDescription="@null"
      android:scaleType="fitXY"
      android:src="@drawable/widget_item_tintable" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingHorizontal="13dp"
      android:paddingVertical="7dp">

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:id="@+id/grade_2_subject"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:fontFamily="sans-serif-medium"
          android:maxLines="1"
          android:textSize="11.5sp" />

        <TextView
          android:id="@+id/grade_2_subtitle"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:ellipsize="end"
          android:fontFamily="sans-serif-medium"
          android:maxLines="1"
          android:textSize="13.5sp"
          android:textStyle="bold" />
      </LinearLayout>

      <TextView
        android:id="@+id/grade_2_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textSize="15.5sp"
        android:textStyle="bold" />
    </LinearLayout>
  </FrameLayout>

  <FrameLayout
    android:id="@+id/grade_3_container"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="6dp"
    android:layout_weight="1"
    android:visibility="gone">

    <ImageView
      android:id="@+id/grade_3_bg"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:contentDescription="@null"
      android:scaleType="fitXY"
      android:src="@drawable/widget_item_tintable" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingHorizontal="13dp"
      android:paddingVertical="7dp">

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:id="@+id/grade_3_subject"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:fontFamily="sans-serif-medium"
          android:maxLines="1"
          android:textSize="11.5sp" />

        <TextView
          android:id="@+id/grade_3_subtitle"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:ellipsize="end"
          android:fontFamily="sans-serif-medium"
          android:maxLines="1"
          android:textSize="13.5sp"
          android:textStyle="bold" />
      </LinearLayout>

      <TextView
        android:id="@+id/grade_3_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textSize="15.5sp"
        android:textStyle="bold" />
    </LinearLayout>
  </FrameLayout>
</LinearLayout>
