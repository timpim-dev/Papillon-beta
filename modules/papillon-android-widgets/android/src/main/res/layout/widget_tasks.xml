<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_background"
  android:orientation="vertical"
  android:padding="12dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp"
    android:paddingBottom="8dp">

    <TextView
      android:id="@+id/widget_header_title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:fontFamily="sans-serif-medium"
      android:maxLines="1"
      android:text="@string/widget_tasks_title"
      android:textColor="@color/papillon_widget_text_secondary"
      android:textSize="13.5sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/widget_tasks_count_badge"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/widget_neutral_pill"
      android:fontFamily="sans-serif-medium"
      android:paddingHorizontal="10dp"
      android:paddingVertical="4dp"
      android:text="@string/widget_see_more"
      android:textColor="@color/papillon_widget_text_secondary"
      android:textSize="11sp"
      android:textStyle="bold" />
  </LinearLayout>

  <TextView
    android:id="@+id/widget_empty_text"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center"
    android:text="@string/widget_tasks_empty"
    android:textColor="@color/papillon_widget_text_secondary"
    android:textSize="13sp"
    android:visibility="gone" />

  <LinearLayout
    android:id="@+id/task_1_container"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:background="@drawable/widget_task_card_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp"
    android:visibility="gone">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/task_1_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="15sp" />

      <TextView
        android:id="@+id/task_1_subject"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textSize="12.5sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/task_1_due"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/papillon_widget_text_secondary"
        android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/task_1_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/papillon_widget_text_primary"
        android:textSize="13sp" />

      <TextView
        android:id="@+id/task_1_check"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_check_circle"
        android:gravity="center"
        android:text="✓"
        android:textColor="@color/papillon_widget_text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
    android:id="@+id/task_2_container"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="6dp"
    android:layout_weight="1"
    android:background="@drawable/widget_task_card_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp"
    android:visibility="gone">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/task_2_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="15sp" />

      <TextView
        android:id="@+id/task_2_subject"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textSize="12.5sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/task_2_due"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/papillon_widget_text_secondary"
        android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/task_2_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/papillon_widget_text_primary"
        android:textSize="13sp" />

      <TextView
        android:id="@+id/task_2_check"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_check_circle"
        android:gravity="center"
        android:text="✓"
        android:textColor="@color/papillon_widget_text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
    android:id="@+id/task_3_container"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="6dp"
    android:layout_weight="1"
    android:background="@drawable/widget_task_card_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp"
    android:visibility="gone">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/task_3_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="15sp" />

      <TextView
        android:id="@+id/task_3_subject"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textSize="12.5sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/task_3_due"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/papillon_widget_text_secondary"
        android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/task_3_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/papillon_widget_text_primary"
        android:textSize="13sp" />

      <TextView
        android:id="@+id/task_3_check"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_check_circle"
        android:gravity="center"
        android:text="✓"
        android:textColor="@color/papillon_widget_text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
