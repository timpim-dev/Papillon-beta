<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_background"
  android:orientation="vertical"
  android:padding="14dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingBottom="10dp">

    <ImageView
      android:id="@+id/widget_header_icon"
      android:layout_width="18dp"
      android:layout_height="18dp"
      android:layout_marginEnd="8dp"
      android:contentDescription="@null"
      android:src="@drawable/ic_widget_tasks"
      android:tint="@color/papillon_widget_text_secondary" />

    <TextView
      android:id="@+id/widget_header_title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:fontFamily="sans-serif-medium"
      android:maxLines="1"
      android:text="@string/widget_tasks_title"
      android:textColor="@color/papillon_widget_text_secondary"
      android:textSize="14sp"
      android:textStyle="bold" />

    <LinearLayout
      android:id="@+id/widget_header_badge"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/widget_neutral_pill"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingHorizontal="10dp"
      android:paddingVertical="5dp">

      <TextView
        android:id="@+id/widget_header_badge_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/widget_see_more"
        android:textColor="@color/papillon_widget_text_secondary"
        android:textSize="11.5sp"
        android:textStyle="bold" />

      <ImageView
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="4dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_widget_arrow_up_right"
        android:tint="@color/papillon_widget_text_secondary" />
    </LinearLayout>
  </LinearLayout>

  <TextView
    android:id="@+id/widget_empty_text"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center"
    android:text="@string/widget_tasks_empty"
    android:textColor="@color/papillon_widget_text_secondary"
    android:textSize="13sp"
    android:visibility="gone" />

  <LinearLayout
    android:id="@+id/task_1_container"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:background="@drawable/widget_task_card_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical"
      android:paddingEnd="10dp">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/task_1_emoji"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginEnd="5dp"
          android:textSize="13sp" />

        <TextView
          android:id="@+id/task_1_subject"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:ellipsize="end"
          android:fontFamily="sans-serif-medium"
          android:maxLines="1"
          android:textSize="12.5sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/task_1_due"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="6dp"
          android:maxLines="1"
          android:textColor="@color/papillon_widget_text_secondary"
          android:textSize="11sp" />
      </LinearLayout>

      <TextView
        android:id="@+id/task_1_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:textColor="@color/papillon_widget_text_primary"
        android:textSize="13.5sp"
        android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
      android:id="@+id/task_1_check_btn"
      android:layout_width="32dp"
      android:layout_height="32dp"
      android:background="@drawable/widget_check_circle">

      <ImageView
        android:id="@+id/task_1_check_icon"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:src="@drawable/ic_widget_check"
        android:tint="@color/papillon_widget_text_secondary" />
    </FrameLayout>
  </LinearLayout>

  <LinearLayout
    android:id="@+id/task_2_container"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="7dp"
    android:layout_weight="1"
    android:background="@drawable/widget_task_card_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical"
      android:paddingEnd="10dp">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/task_2_emoji"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginEnd="5dp"
          android:textSize="13sp" />

        <TextView
          android:id="@+id/task_2_subject"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:ellipsize="end"
          android:fontFamily="sans-serif-medium"
          android:maxLines="1"
          android:textSize="12.5sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/task_2_due"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="6dp"
          android:maxLines="1"
          android:textColor="@color/papillon_widget_text_secondary"
          android:textSize="11sp" />
      </LinearLayout>

      <TextView
        android:id="@+id/task_2_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:textColor="@color/papillon_widget_text_primary"
        android:textSize="13.5sp"
        android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
      android:id="@+id/task_2_check_btn"
      android:layout_width="32dp"
      android:layout_height="32dp"
      android:background="@drawable/widget_check_circle">

      <ImageView
        android:id="@+id/task_2_check_icon"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:src="@drawable/ic_widget_check"
        android:tint="@color/papillon_widget_text_secondary" />
    </FrameLayout>
  </LinearLayout>

  <LinearLayout
    android:id="@+id/task_3_container"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="7dp"
    android:layout_weight="1"
    android:background="@drawable/widget_task_card_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical"
      android:paddingEnd="10dp">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/task_3_emoji"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginEnd="5dp"
          android:textSize="13sp" />

        <TextView
          android:id="@+id/task_3_subject"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:ellipsize="end"
          android:fontFamily="sans-serif-medium"
          android:maxLines="1"
          android:textSize="12.5sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/task_3_due"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="6dp"
          android:maxLines="1"
          android:textColor="@color/papillon_widget_text_secondary"
          android:textSize="11sp" />
      </LinearLayout>

      <TextView
        android:id="@+id/task_3_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:textColor="@color/papillon_widget_text_primary"
        android:textSize="13.5sp"
        android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
      android:id="@+id/task_3_check_btn"
      android:layout_width="32dp"
      android:layout_height="32dp"
      android:background="@drawable/widget_check_circle">

      <ImageView
        android:id="@+id/task_3_check_icon"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:src="@drawable/ic_widget_check"
        android:tint="@color/papillon_widget_text_secondary" />
    </FrameLayout>
  </LinearLayout>
</LinearLayout>
