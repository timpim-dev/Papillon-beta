<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_background"
  android:orientation="vertical"
  android:paddingHorizontal="12dp"
  android:paddingVertical="8dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingBottom="6dp">

    <ImageView
      android:id="@+id/widget_header_icon"
      android:layout_width="16dp"
      android:layout_height="16dp"
      android:layout_marginEnd="6dp"
      android:contentDescription="@null"
      android:src="@drawable/ic_widget_calendar"
      android:tint="@color/papillon_widget_text_secondary" />

    <TextView
      android:id="@+id/widget_header_title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:fontFamily="sans-serif-medium"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:text="@string/widget_next_classes_title"
      android:textColor="@color/papillon_widget_text_secondary"
      android:textSize="13sp"
      android:textStyle="bold" />

    <LinearLayout
      android:id="@+id/widget_header_badge"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/widget_neutral_pill"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingHorizontal="9dp"
      android:paddingVertical="4dp">

      <TextView
        android:id="@+id/widget_header_badge_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:text="@string/widget_see_more"
        android:textColor="@color/papillon_widget_text_secondary"
        android:textSize="11sp"
        android:textStyle="bold" />

      <ImageView
        android:layout_width="11dp"
        android:layout_height="11dp"
        android:layout_marginStart="4dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_widget_arrow_up_right"
        android:tint="@color/papillon_widget_text_secondary" />
    </LinearLayout>
  </LinearLayout>

  <TextView
    android:id="@+id/widget_empty_text"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center"
    android:text="@string/widget_next_classes_empty"
    android:textColor="@color/papillon_widget_text_secondary"
    android:textSize="13sp"
    android:visibility="gone" />

  <LinearLayout
    android:id="@+id/course_1_container"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
      android:layout_width="56dp"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="vertical"
      android:paddingEnd="6dp">

      <TextView
        android:id="@+id/course_1_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textSize="12.5sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/course_1_end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textSize="10.5sp" />
    </LinearLayout>

    <FrameLayout
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1">

      <ImageView
        android:id="@+id/course_1_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_item_tintable" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp">

        <ImageView
          android:id="@+id/course_1_color"
          android:layout_width="5dp"
          android:layout_height="match_parent"
          android:layout_marginEnd="10dp"
          android:contentDescription="@null"
          android:scaleType="fitXY"
          android:src="@drawable/widget_color_bar" />

        <TextView
          android:id="@+id/course_1_subject"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:ellipsize="end"
          android:fontFamily="sans-serif-medium"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:textSize="14sp"
          android:textStyle="bold" />
      </LinearLayout>
    </FrameLayout>
  </LinearLayout>

  <LinearLayout
    android:id="@+id/course_2_container"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="4dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
      android:layout_width="56dp"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="vertical"
      android:paddingEnd="6dp">

      <TextView
        android:id="@+id/course_2_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textSize="12.5sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/course_2_end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textSize="10.5sp" />
    </LinearLayout>

    <FrameLayout
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1">

      <ImageView
        android:id="@+id/course_2_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_item_tintable" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp">

        <ImageView
          android:id="@+id/course_2_color"
          android:layout_width="5dp"
          android:layout_height="match_parent"
          android:layout_marginEnd="10dp"
          android:contentDescription="@null"
          android:scaleType="fitXY"
          android:src="@drawable/widget_color_bar" />

        <TextView
          android:id="@+id/course_2_subject"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:ellipsize="end"
          android:fontFamily="sans-serif-medium"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:textSize="14sp"
          android:textStyle="bold" />
      </LinearLayout>
    </FrameLayout>
  </LinearLayout>

  <LinearLayout
    android:id="@+id/course_3_container"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="4dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
      android:layout_width="56dp"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="vertical"
      android:paddingEnd="6dp">

      <TextView
        android:id="@+id/course_3_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textSize="12.5sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/course_3_end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textSize="10.5sp" />
    </LinearLayout>

    <FrameLayout
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1">

      <ImageView
        android:id="@+id/course_3_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_item_tintable" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp">

        <ImageView
          android:id="@+id/course_3_color"
          android:layout_width="5dp"
          android:layout_height="match_parent"
          android:layout_marginEnd="10dp"
          android:contentDescription="@null"
          android:scaleType="fitXY"
          android:src="@drawable/widget_color_bar" />

        <TextView
          android:id="@+id/course_3_subject"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:ellipsize="end"
          android:fontFamily="sans-serif-medium"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:textSize="14sp"
          android:textStyle="bold" />
      </LinearLayout>
    </FrameLayout>
  </LinearLayout>
</LinearLayout>
