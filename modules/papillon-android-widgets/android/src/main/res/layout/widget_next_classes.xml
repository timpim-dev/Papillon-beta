<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_background"
  android:orientation="vertical"
  android:padding="12dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp"
    android:paddingBottom="8dp">

    <TextView
      android:id="@+id/widget_header_title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:fontFamily="sans-serif-medium"
      android:maxLines="1"
      android:text="@string/widget_next_classes_title"
      android:textColor="@color/papillon_widget_text_secondary"
      android:textSize="13.5sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/widget_header_badge"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/widget_neutral_pill"
      android:fontFamily="sans-serif-medium"
      android:paddingHorizontal="10dp"
      android:paddingVertical="4dp"
      android:text="@string/widget_see_more"
      android:textColor="@color/papillon_widget_text_secondary"
      android:textSize="11sp"
      android:textStyle="bold" />
  </LinearLayout>

  <TextView
    android:id="@+id/widget_empty_text"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center"
    android:text="@string/widget_next_classes_empty"
    android:textColor="@color/papillon_widget_text_secondary"
    android:textSize="13sp"
    android:visibility="gone" />

  <LinearLayout
    android:id="@+id/course_1_container"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:visibility="gone">

    <LinearLayout
      android:layout_width="50dp"
      android:layout_height="wrap_content"
      android:layout_marginEnd="10dp"
      android:gravity="center"
      android:orientation="vertical">

      <TextView
        android:id="@+id/course_1_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/papillon_widget_text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/course_1_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/papillon_widget_text_secondary"
        android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1">

      <ImageView
        android:id="@+id/course_1_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_item_tintable" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="11dp"
        android:paddingVertical="7dp">

        <ImageView
          android:id="@+id/course_1_color"
          android:layout_width="5dp"
          android:layout_height="match_parent"
          android:layout_marginVertical="2dp"
          android:layout_marginEnd="9dp"
          android:contentDescription="@null"
          android:src="@drawable/widget_color_bar" />

        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical">

          <TextView
            android:id="@+id/course_1_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textSize="13.5sp"
            android:textStyle="bold" />

          <TextView
            android:id="@+id/course_1_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textSize="11.5sp" />

          <TextView
            android:id="@+id/course_1_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="11sp" />
        </LinearLayout>
      </LinearLayout>
    </FrameLayout>
  </LinearLayout>

  <LinearLayout
    android:id="@+id/course_2_container"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="6dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:visibility="gone">

    <LinearLayout
      android:layout_width="50dp"
      android:layout_height="wrap_content"
      android:layout_marginEnd="10dp"
      android:gravity="center"
      android:orientation="vertical">

      <TextView
        android:id="@+id/course_2_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/papillon_widget_text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/course_2_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/papillon_widget_text_secondary"
        android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1">

      <ImageView
        android:id="@+id/course_2_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_item_tintable" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="11dp"
        android:paddingVertical="7dp">

        <ImageView
          android:id="@+id/course_2_color"
          android:layout_width="5dp"
          android:layout_height="match_parent"
          android:layout_marginVertical="2dp"
          android:layout_marginEnd="9dp"
          android:contentDescription="@null"
          android:src="@drawable/widget_color_bar" />

        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical">

          <TextView
            android:id="@+id/course_2_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textSize="13.5sp"
            android:textStyle="bold" />

          <TextView
            android:id="@+id/course_2_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textSize="11.5sp" />

          <TextView
            android:id="@+id/course_2_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="11sp" />
        </LinearLayout>
      </LinearLayout>
    </FrameLayout>
  </LinearLayout>

  <LinearLayout
    android:id="@+id/course_3_container"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="6dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:visibility="gone">

    <LinearLayout
      android:layout_width="50dp"
      android:layout_height="wrap_content"
      android:layout_marginEnd="10dp"
      android:gravity="center"
      android:orientation="vertical">

      <TextView
        android:id="@+id/course_3_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/papillon_widget_text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/course_3_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/papillon_widget_text_secondary"
        android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1">

      <ImageView
        android:id="@+id/course_3_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_item_tintable" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="11dp"
        android:paddingVertical="7dp">

        <ImageView
          android:id="@+id/course_3_color"
          android:layout_width="5dp"
          android:layout_height="match_parent"
          android:layout_marginVertical="2dp"
          android:layout_marginEnd="9dp"
          android:contentDescription="@null"
          android:src="@drawable/widget_color_bar" />

        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical">

          <TextView
            android:id="@+id/course_3_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textSize="13.5sp"
            android:textStyle="bold" />

          <TextView
            android:id="@+id/course_3_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textSize="11.5sp" />

          <TextView
            android:id="@+id/course_3_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="11sp" />
        </LinearLayout>
      </LinearLayout>
    </FrameLayout>
  </LinearLayout>
</LinearLayout>
